def find_common_participants(list1, list2, separator=","): #создаем функцию, и, как я обусловился, использую разделитель "|".
    newlist1 = set((list1.split(separator))) #Используем метод split с указанием разделителя, чтобы от строки перейти к списку
    newlist2 = set((list2.split(separator))) #Также добавляем функцию set, чтобы исключить повторения и

    similar_names = newlist1.intersection(newlist2) #Использую метод, чтобы найти пересечения множеств, созданных выше.

    return similar_names


participants_first_group = "Иванов|Петров|Сидоров"
participants_second_group = "Петров|Сидоров|Смирнов"

similar_names = find_common_participants(participants_first_group, participants_second_group)

print(f'Общие участники в списках: {similar_names}')


